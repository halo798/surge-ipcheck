#!name=IP 检测（Mac）
#!desc=本地 / 入口 / 落地 IP 的位置与运营商，执行策略路径；落地 IP 原生/家宽判定与多数据库风险评分。面板在菜单栏「面板」子菜单，完整报告：浏览器打开 http://ipcheck.surge
#!category=工具
#!system=mac
#!arguments=POLICY:auto,TIMEOUT:6,CACHE:1800,LOCAL:1,MASK:0,IPV6:0,NOTIFY:0,IPQS_KEY:none,ABUSEIPDB_KEY:none,IPAPI_KEY:none,IPREGISTRY_KEY:none,IPDATA_KEY:none,IP2LOCATION_KEY:none,PROXYCHECK_KEY:none
#!arguments-desc=POLICY：落地检测走的策略或策略组名称，auto 表示按规则分流\nTIMEOUT：单个请求超时（秒）\nCACHE：IP 质量结果缓存秒数，0 为不缓存\nLOCAL：0 = 隐藏本地 IP 和位置（面板、通知、报告都不显示，也不查询）\nMASK：1 = 隐藏 IP 后两段（方便截图）\nIPV6：1 = 同时检测 IPv6 落地\nNOTIFY：1 = 网络切换后发通知\n\n以下 Key 选填，none 表示不填，填了才查询对应数据库：\nIPQS_KEY、ABUSEIPDB_KEY、IPAPI_KEY（ipapi.is）、IPREGISTRY_KEY、IPDATA_KEY\nIP2LOCATION_KEY：提高额度，付费套餐另有使用类型与欺诈分\nPROXYCHECK_KEY：提高额度

[Panel]
IPCheck = title="IP 检测", content="点刷新开始检测", style=info, script-name=IPCheck, update-interval=300

[Script]
IPCheck = type=generic, timeout=60, script-path=https://raw.githubusercontent.com/halo798/surge-ipcheck/main/ipcheck.js, argument="policy={{{POLICY}}}&timeout={{{TIMEOUT}}}&cache={{{CACHE}}}&local={{{LOCAL}}}&mask={{{MASK}}}&ipv6={{{IPV6}}}&notify={{{NOTIFY}}}&ipqs_key={{{IPQS_KEY}}}&abuseipdb_key={{{ABUSEIPDB_KEY}}}&ipapi_key={{{IPAPI_KEY}}}&ipregistry_key={{{IPREGISTRY_KEY}}}&ipdata_key={{{IPDATA_KEY}}}&ip2location_key={{{IP2LOCATION_KEY}}}&proxycheck_key={{{PROXYCHECK_KEY}}}"
IPCheck-Report = type=http-request, pattern=^http:\/\/ipcheck\.surge\/, timeout=60, script-path=https://raw.githubusercontent.com/halo798/surge-ipcheck/main/ipcheck.js, argument="policy={{{POLICY}}}&timeout={{{TIMEOUT}}}&cache={{{CACHE}}}&local={{{LOCAL}}}&mask={{{MASK}}}&ipv6={{{IPV6}}}&notify={{{NOTIFY}}}&ipqs_key={{{IPQS_KEY}}}&abuseipdb_key={{{ABUSEIPDB_KEY}}}&ipapi_key={{{IPAPI_KEY}}}&ipregistry_key={{{IPREGISTRY_KEY}}}&ipdata_key={{{IPDATA_KEY}}}&ip2location_key={{{IP2LOCATION_KEY}}}&proxycheck_key={{{PROXYCHECK_KEY}}}"
IPCheck-Notify = type=event, event-name=network-changed, timeout=60, script-path=https://raw.githubusercontent.com/halo798/surge-ipcheck/main/ipcheck.js, argument="policy={{{POLICY}}}&timeout={{{TIMEOUT}}}&cache={{{CACHE}}}&local={{{LOCAL}}}&mask={{{MASK}}}&ipv6={{{IPV6}}}&notify={{{NOTIFY}}}&ipqs_key={{{IPQS_KEY}}}&abuseipdb_key={{{ABUSEIPDB_KEY}}}&ipapi_key={{{IPAPI_KEY}}}&ipregistry_key={{{IPREGISTRY_KEY}}}&ipdata_key={{{IPDATA_KEY}}}&ip2location_key={{{IP2LOCATION_KEY}}}&proxycheck_key={{{PROXYCHECK_KEY}}}"

[Rule]
DOMAIN,ipcheck.surge,DIRECT
